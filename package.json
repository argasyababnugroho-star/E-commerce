{
  "name": "ecommerce",
  "private": true,
  "workspaces": [
    "apps/ecommerce-web-nextjs",
    "apps/ecommerce-api-elysia",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --cwd apps/ecommerce-web-nextjs dev",
    "dev:api": "bun run --cwd apps/ecommerce-api-elysia dev",
    "dev:mobile": "bun run --cwd apps/ecommerce-mob-expo/ecommerce-app start",
    "db:generate": "bun run --cwd packages/database prisma generate",
    "db:migrate": "bun run --cwd packages/database prisma migrate dev",
    "db:validate": "bun run --cwd packages/database prisma validate",
    "db:studio": "bun run --cwd packages/database prisma studio"
  }
}